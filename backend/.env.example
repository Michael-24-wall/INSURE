# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Prometheus metrics. Enable to expose /metrics (restrict access at the edge).
PROMETHEUS_METRICS_ENABLED=False

# Transport security. Set these when serving over HTTPS in production.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Database: leave empty for SQLite (development). Use PostgreSQL in production.
# DATABASE_URL=postgresql://autoinssure:autoinssure@localhost:5432/autoinssure

# Cache / Redis / Celery
# CACHE_URL=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Credential encryption (used for insurer integration secrets at rest)
CREDENTIAL_ENCRYPTION_KEY=change-me-too

# M-Pesa Daraja. Leave blank to keep gateway disabled; payments then require
# authorised manual reconciliation. Set M_PESA_ENV=sandbox or production.
M_PESA_CONSUMER_KEY=
M_PESA_CONSUMER_SECRET=
M_PESA_SHORTCODE=
M_PESA_PASSKEY=
M_PESA_CALLBACK_URL=https://your-domain.example/api/v1/payments/mpesa/callback/
M_PESA_ENV=sandbox
# Comma-separated IP ranges to accept M-Pesa callbacks from. In production this
# MUST be set — an empty list fails closed and rejects every callback.
M_PESA_ALLOWED_IPS=

# Card gateway (Flutterwave). Leave blank to disable card payments.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENV=sandbox
# Webhook signature secret. In production this MUST be set — an empty value
# fails closed and rejects unsigned webhooks.
FLW_WEBHOOK_HASH=
CARD_REDIRECT_URL=http://localhost:5173/app/payments

# Payment automation
PAYMENT_MPESA_TIMEOUT_MINUTES=15
PAYMENT_BANK_TIMEOUT_DAYS=7
PAYMENT_CARD_TIMEOUT_MINUTES=30

# Compliance
KYC_REQUIRED_FOR_POLICY_ISSUANCE=True

# Default reporting currency (used only where a record has no explicit currency)
DEFAULT_CURRENCY=KES

# AI provider (heuristic by default; set AI_PROVIDER=remote with key+url for vision/OCR)
AI_PROVIDER=heuristic
AI_API_KEY=
AI_API_URL=
AI_MODEL=gpt-4o

# Email (console in dev; use SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@autoinssure.local

# JWT token lifetime
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Notification delivery channels for notify(): in_app,email,sms
NOTIFICATION_CHANNELS=in_app
